---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 · Page not found">
  <main class="grid min-h-screen place-items-center">
    <div class="container-page text-center">
      <p class="eyebrow">404</p>
      <h1 class="mt-4 font-display text-display-xl text-ink">Not found.</h1>
      <p class="mt-4 text-ink-muted">That page doesn't exist.</p>
      <a href="/" class="btn btn-primary mt-8 inline-flex">Back to home</a>
    </div>
  </main>
</Layout>
