---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Overview from "../components/Overview.astro";
import Algorithms from "../components/Algorithms.astro";
import Features from "../components/Features.astro";
import Guarantees from "../components/Guarantees.astro";
import Code from "../components/Code.astro";
import Results from "../components/Results.astro";
import UseCases from "../components/UseCases.astro";
import API from "../components/API.astro";
import Install from "../components/Install.astro";
import Citation from "../components/Citation.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="GRNBT — Gradient Regularized Newton Boosting Trees"
  description="A pure-Python, NumPy-only reproduction of gradient-regularized Newton boosting trees — second-order boosting with adaptive regularization and global convergence guarantees."
>
  <Nav />

  <main id="main">
    <Hero />
    <Overview />
    <Algorithms />
    <Features />
    <Guarantees />
    <Code />
    <Results />
    <UseCases />
    <API />
    <Install />
    <Citation />
    <CTA />
  </main>

  <Footer />
</Layout>
