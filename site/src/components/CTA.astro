---
import { withBase } from "../lib/paths";
---

<section class="relative isolate overflow-hidden">
  <div aria-hidden="true" class="absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-grid"></div>
    <div
      class="glow-blob left-[15%] top-[-20%] h-[28rem] w-[28rem] bg-gradient-to-tr from-accent-500/30 via-signal-violet/20 to-transparent"
    ></div>
    <div
      class="glow-blob right-[10%] bottom-[-30%] h-[24rem] w-[24rem] bg-gradient-to-bl from-signal-cyan/30 via-accent-500/15 to-transparent"
    ></div>
  </div>

  <div class="container-page">
    <div
      class="reveal relative overflow-hidden rounded-[2rem] border border-line bg-elev p-10 text-center shadow-soft-xl md:p-16"
    >
      <div class="mx-auto max-w-2xl">
        <span class="badge">
          <span class="inline-block h-1.5 w-1.5 animate-pulse-soft rounded-full bg-signal-green"></span>
          v0.1.0 · MIT
        </span>
        <h2
          class="mt-6 font-display text-display-xl text-balance text-ink"
        >
          Read the paper.
          <span class="text-gradient-brand">Run the code.</span>
        </h2>
        <p class="mt-6 text-[15.5px] leading-relaxed text-ink-muted">
          A faithful, dependency-free reference implementation of Newton's
          second-order boosting — regularized, proven, and ready to inspect.
        </p>
        <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
          <a href={withBase("#install")} class="btn btn-gradient !px-5 !py-3 !text-[14px]">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" />
            </svg>
            pip install grnbt
          </a>
          <a
            href="https://github.com/sachncs/gradient-regularized-newton-boosting-trees"
            target="_blank"
            rel="noopener"
            class="btn btn-ghost !px-5 !py-3 !text-[14px]"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56 0-.28-.01-1.02-.01-2-3.2.69-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.17 1.18.92-.26 1.91-.39 2.89-.39.98 0 1.97.13 2.89.39 2.2-1.49 3.17-1.18 3.17-1.18.62 1.58.23 2.75.11 3.04.74.8 1.18 1.83 1.18 3.09 0 4.43-2.7 5.41-5.27 5.7.41.36.78 1.07.78 2.15 0 1.55-.01 2.8-.01 3.18 0 .31.21.67.8.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5Z"
              />
            </svg>
            Star on GitHub
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
