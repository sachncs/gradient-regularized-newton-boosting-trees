---
const results = [
  {
    eyebrow: "Paper Figure 1 · Wine Quality (Charbonnier)",
    title: "Three engines, one plot, three behaviours.",
    body:
      "Vanilla Newton diverges. The static-high-λ baseline plateaus biased. GRN's adaptive λₖ converges — steadily and provably.",
    chips: ["Vanilla · diverges", "GRN · converges", "Static · plateau"],
  },
  {
    eyebrow: "Paper Figure 2 · Higgs (BCE)",
    title: "Diagnostics you can plot.",
    body:
      "Record the cosine angle Θₖ and weak gradient edge γₖ per iteration. Verify Lemma 4.2 numerically on a trained model.",
    chips: ["Θₖ", "γₖ", "Lemma 4.2"],
  },
  {
    eyebrow: "Hyperparameter ablations",
    title: "108 configurations × 3 seeds.",
    body:
      "Loss × engine × η × depth × λ_base grid, written to a tidy CSV. Aggregate with one line of pandas.",
    chips: ["324 runs", "CSV output"],
  },
];
---

<section id="results" class="section relative">
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-grid opacity-60"></div>
  <div class="container-page">
    <div class="reveal max-w-3xl">
      <p class="eyebrow">Reproducible experiments</p>
      <h2 class="mt-4 font-display text-display-lg text-balance text-ink">
        Paper figures, not promises.
      </h2>
      <p class="mt-6 text-[15px] leading-relaxed text-ink-muted">
        Three experiment scripts reproduce Figures 1, 2 and the hyperparameter
        ablations from Zozoulenko et al. (2026). Machine-readable artifacts
        written to <code class="font-mono text-ink">experiments/</code>.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-5 md:grid-cols-3">
      {
        results.map((r, i) => (
          <article
            class="reveal card relative flex flex-col overflow-hidden p-6 md:p-7"
            style={`animation-delay: ${i * 80}ms;`}
          >
            <span class="eyebrow">{r.eyebrow}</span>
            <h3 class="mt-3 font-display text-[1.125rem] font-semibold tracking-tight text-ink">
              {r.title}
            </h3>
            <p class="mt-2 text-[14px] leading-relaxed text-ink-muted">
              {r.body}
            </p>

            <!-- Mini chart placeholders -->
            <div class="mt-6 rounded-xl border border-line bg-bg-deep/50 p-4">
              {i === 0 && (
                <svg viewBox="0 0 300 110" class="block h-24 w-full" aria-hidden="true">
                  <defs>
                    <linearGradient id="r-grad-1" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="#10b981" stop-opacity="0.4" />
                      <stop offset="100%" stop-color="#10b981" stop-opacity="0" />
                    </linearGradient>
                  </defs>
                  <path
                    d="M5,15 C40,30 80,55 140,72 C200,85 250,90 295,92"
                    fill="none"
                    stroke="#ef4444"
                    stroke-width="1.8"
                    stroke-linecap="round"
                  />
                  <path
                    d="M5,80 C40,75 80,68 140,62 C200,58 250,57 295,57"
                    fill="none"
                    stroke="#f59e0b"
                    stroke-width="1.8"
                    stroke-linecap="round"
                  />
                  <path
                    d="M5,90 C40,70 80,40 140,22 C200,12 250,8 295,7 L295,110 L5,110 Z"
                    fill="url(#r-grad-1)"
                  />
                  <path
                    d="M5,90 C40,70 80,40 140,22 C200,12 250,8 295,7"
                    fill="none"
                    stroke="#10b981"
                    stroke-width="2"
                    stroke-linecap="round"
                  />
                </svg>
              )}
              {i === 1 && (
                <svg viewBox="0 0 300 110" class="block h-24 w-full" aria-hidden="true">
                  <defs>
                    <linearGradient id="r-grad-2" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="#6366f1" stop-opacity="0.4" />
                      <stop offset="100%" stop-color="#6366f1" stop-opacity="0" />
                    </linearGradient>
                  </defs>
                  <path
                    d="M5,80 C40,55 80,40 140,30 C200,22 250,18 295,15 L295,110 L5,110 Z"
                    fill="url(#r-grad-2)"
                  />
                  <path
                    d="M5,80 C40,55 80,40 140,30 C200,22 250,18 295,15"
                    fill="none"
                    stroke="#6366f1"
                    stroke-width="2"
                    stroke-linecap="round"
                  />
                  <path
                    d="M5,40 C40,55 80,68 140,78 C200,86 250,90 295,92"
                    fill="none"
                    stroke="#06b6d4"
                    stroke-width="2"
                    stroke-dasharray="3 3"
                    stroke-linecap="round"
                  />
                </svg>
              )}
              {i === 2 && (
                <div class="flex h-24 items-end justify-between gap-1.5">
                  {[42, 38, 36, 34, 33, 30, 28, 26, 25, 22, 20, 18, 16, 14].map((h, idx) => (
                    <span
                      class="block w-full rounded-sm bg-gradient-to-t from-accent-500/30 to-accent-500/70"
                      style={`height: ${h * 2}%; opacity: ${0.4 + idx * 0.04};`}
                    />
                  ))}
                </div>
              )}
            </div>

            <div class="mt-5 flex flex-wrap items-center gap-1.5">
              {r.chips.map((c) => <span class="chip">{c}</span>)}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
