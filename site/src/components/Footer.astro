---
const year = new Date().getFullYear();

const columns = [
  {
    label: "Product",
    links: [
      { label: "Overview", href: "#overview" },
      { label: "Algorithms", href: "#algorithms" },
      { label: "Guarantees", href: "#guarantees" },
      { label: "Results", href: "#results" },
      { label: "Install", href: "#install" },
    ],
  },
  {
    label: "Resources",
    links: [
      { label: "GitHub", href: "https://github.com/sachncs/gradient-regularized-newton-boosting-trees", external: true },
      { label: "Mathematical foundations", href: "https://github.com/sachncs/gradient-regularized-newton-boosting-trees/blob/master/docs/math.md", external: true },
      { label: "Architecture", href: "https://github.com/sachncs/gradient-regularized-newton-boosting-trees/blob/master/docs/architecture.md", external: true },
      { label: "API reference", href: "https://github.com/sachncs/gradient-regularized-newton-boosting-trees/blob/master/docs/api.md", external: true },
      { label: "Fidelity report", href: "https://github.com/sachncs/gradient-regularized-newton-boosting-trees/blob/master/docs/fidelity.md", external: true },
    ],
  },
  {
    label: "Project",
    links: [
      { label: "PyPI", href: "https://pypi.org/project/grnbt/", external: true },
      { label: "Changelog", href: "https://github.com/sachncs/gradient-regularized-newton-boosting-trees/blob/master/CHANGELOG.md", external: true },
      { label: "Roadmap", href: "https://github.com/sachncs/gradient-regularized-newton-boosting-trees/blob/master/ROADMAP.md", external: true },
      { label: "Contributing", href: "https://github.com/sachncs/gradient-regularized-newton-boosting-trees/blob/master/CONTRIBUTING.md", external: true },
      { label: "Citation", href: "#citation" },
    ],
  },
];
---

<footer class="border-t border-line">
  <div class="container-page py-16">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-12">
      <!-- Brand block -->
      <div class="md:col-span-5">
        <div class="flex items-center gap-2.5">
          <span class="relative grid h-7 w-7 place-items-center overflow-hidden rounded-lg" aria-hidden="true">
            <span class="absolute inset-0 bg-gradient-to-br from-accent-500 via-signal-cyan to-signal-violet"></span>
            <span class="relative font-display text-[13px] font-bold text-white">G</span>
          </span>
          <span class="font-display text-[15px] font-semibold tracking-tight text-ink">GRNBT</span>
        </div>
        <p class="mt-4 max-w-md text-[14px] leading-relaxed text-ink-muted">
          Gradient Regularized Newton Boosting Trees &mdash; a paper-faithful
          reference implementation, released as open source under the MIT
          license.
        </p>
        <div class="mt-6 flex items-center gap-3">
          <a
            href="https://github.com/sachncs/gradient-regularized-newton-boosting-trees"
            target="_blank"
            rel="noopener"
            aria-label="GitHub"
            class="grid h-9 w-9 place-items-center rounded-full border border-line text-ink-muted transition-colors hover:border-line-strong hover:bg-bg-deep hover:text-ink"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56 0-.28-.01-1.02-.01-2-3.2.69-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.17 1.18.92-.26 1.91-.39 2.89-.39.98 0 1.97.13 2.89.39 2.2-1.49 3.17-1.18 3.17-1.18.62 1.58.23 2.75.11 3.04.74.8 1.18 1.83 1.18 3.09 0 4.43-2.7 5.41-5.27 5.7.41.36.78 1.07.78 2.15 0 1.55-.01 2.8-.01 3.18 0 .31.21.67.8.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5Z"
              />
            </svg>
          </a>
          <a
            href="https://pypi.org/project/grnbt/"
            target="_blank"
            rel="noopener"
            aria-label="PyPI"
            class="grid h-9 w-9 place-items-center rounded-full border border-line text-ink-muted transition-colors hover:border-line-strong hover:bg-bg-deep hover:text-ink"
          >
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0a12 12 0 1 0 0 24 12 12 0 0 0 0-24Zm-.5 4.5h6.5v3h-3.5v12h-3v-12h-3v-3Z" />
            </svg>
          </a>
          <a
            href="https://github.com/sachncs/gradient-regularized-newton-boosting-trees/blob/master/LICENSE"
            target="_blank"
            rel="noopener"
            class="grid h-9 w-9 place-items-center rounded-full border border-line text-ink-muted transition-colors hover:border-line-strong hover:bg-bg-deep hover:text-ink"
            aria-label="License"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 11.5V20a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-6.5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2ZM22 11.5V20a2 2 0 0 1-2 2h-2a2 2 0 0 1-2-2v-6.5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2ZM11.5 5.5h-2a2 2 0 0 0-2 2v6M12.5 5.5h2a2 2 0 0 1 2 2v3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Link columns -->
      <div class="grid grid-cols-2 gap-8 md:col-span-7 md:grid-cols-3">
        {
          columns.map((col) => (
            <div>
              <div class="eyebrow">{col.label}</div>
              <ul class="mt-4 space-y-2.5">
                {col.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target={(link as any).external ? "_blank" : undefined}
                      rel={(link as any).external ? "noopener" : undefined}
                      class="text-[13.5px] text-ink-muted transition-colors hover:text-ink"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Bottom row -->
    <div class="mt-14 flex flex-col items-start justify-between gap-4 border-t border-line pt-6 text-[12.5px] text-ink-soft sm:flex-row sm:items-center">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
        <span>&copy; {year} Sachin.</span>
        <span class="hidden sm:inline-block">·</span>
        <span>Released under the MIT License.</span>
        <span class="hidden sm:inline-block">·</span>
        <span>
          Reproducing
          <em class="text-ink-muted">Zozoulenko, Falkowski, Cass, Gonon (2026)</em>.
        </span>
      </div>
      <div class="flex items-center gap-2 font-mono">
        <span class="inline-block h-1.5 w-1.5 animate-pulse-soft rounded-full bg-signal-green"></span>
        Built with Astro · Pure NumPy core
      </div>
    </div>
  </div>
</footer>
